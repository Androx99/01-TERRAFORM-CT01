# ==========================================
# Terraform
# ==========================================
# Directorios locales y binarios de plugins descargados
**/.terraform/
.terraform/
**/.terraform/*
.terraform/*

# Archivos de estado de infraestructura (pueden contener contraseñas y datos sensibles)
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.backup.*
.terraform.tfstate.lock.info

# Archivos de logs de errores
crash.log
crash.*.log

# Archivos de planes generados
*.tfplan
*.tfplan.binary

# Archivos de configuracion de CLI de Terraform
.terraformrc
terraform.rc

# ==========================================
# Binarios y ejecutables
# ==========================================
*.exe
*.dll
*.so
*.dylib
*.zip
*.tar.gz

# ==========================================
# Secretos, credenciales y claves SSH (Labs AWS/EC2)
# ==========================================
*.pem
*.key
*.cer
*.crt
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
.env
.env.*

# ==========================================
# Editores y sistema operativo
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
[Dd]esktop.ini
.DS_Store